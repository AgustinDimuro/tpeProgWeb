package views

templ Login() {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Login - Sistema de Reservas</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
		</head>
		<body>
			<main class="container" style="max-width: 600px; margin-top: 50px;">
				<article>
					<header>
						<h1 style="text-align:center;">Ingreso Cabañas</h1>
					</header>
					<form action="/login" method="POST">
						<label for="cabin_id">Número de Cabaña (ID)</label>
						<input type="number" id="cabin_id" name="cabin_id" placeholder="Ej: 1" required/>
						
						<label for="password">Contraseña</label>
						<input type="password" id="password" name="password" placeholder="Su contraseña" required/>
						
						<button type="submit">Ingresar</button>
					</form>
				</article>
			</main>
		</body>
	</html>
}